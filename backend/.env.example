# ─────────────────────────────────────────────
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/reservation_system

# JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Cloudinary (for image uploads)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ─────────────────────────────────────────────
# Production CORS — set these in Vercel dashboard
# ─────────────────────────────────────────────
FRONTEND_URL_CUSTOMER=https://ecotravel-reservation-system.vercel.app
FRONTEND_URL_SUPPLIER=https://ecotravel-reservation-system-supplier.vercel.app
FRONTEND_URL_ADMIN=https://ecotravel-admin.vercel.app
